{
	"name": "cntui",
	"version": "0.3.2",
	"description": "A terminal UI for Apple's container runtime",
	"type": "module",
	"main": "src/index.tsx",
	"scripts": {
		"dev": "bun --watch run src/index.tsx",
		"build": "bun build src/index.tsx --compile --minify --outfile cntui",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@opentui/core": "0.5.9",
		"@opentui/react": "0.5.9"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@types/bun": "1.4.0",
		"@types/react": "19.2.18",
		"typescript": "7.0.2"
	},
	"license": "MIT",
	"trustedDependencies": [
		"@biomejs/biome"
	]
}
