{
	"name": "ctui",
	"version": "0.1.0",
	"description": "A terminal UI for Apple's container runtime",
	"type": "module",
	"main": "src/index.tsx",
	"scripts": {
		"dev": "bun --watch run src/index.tsx",
		"build": "bun build src/index.tsx --compile --outfile ctui",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@opentui/core": "^0.1.0",
		"@opentui/react": "^0.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/bun": "^1.2.0",
		"@types/react": "^19.2.17",
		"typescript": "^5.7.0"
	},
	"license": "MIT",
	"trustedDependencies": ["@biomejs/biome"]
}
