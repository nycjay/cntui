{
	"name": "cntui",
	"version": "0.1.0",
	"description": "A terminal UI for Apple's container runtime",
	"type": "module",
	"main": "src/index.tsx",
	"scripts": {
		"dev": "bun --watch run src/index.tsx",
		"build": "bun build src/index.tsx --compile --outfile cntui",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@opentui/core": "0.1.107",
		"@opentui/react": "0.1.107"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/bun": "1.3.14",
		"@types/react": "19.2.17",
		"typescript": "5.9.3"
	},
	"license": "MIT",
	"trustedDependencies": ["@biomejs/biome"]
}
