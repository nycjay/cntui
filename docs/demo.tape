Set Shell "bash"
Set FontSize 14
Set Width 1200
Set Height 800
Set Theme "TokyoNight"

Type "cntui"
Enter
Sleep 3s

# Navigate containers
Down
Sleep 500ms
Down
Sleep 500ms
Down
Sleep 500ms

# Open action menu
Enter
Sleep 1.5s
Escape
Sleep 500ms

# Switch to images tab
Type "2"
Sleep 2s

# Switch to system tab
Type "5"
Sleep 2s

# Quit
Type "q"
Sleep 500ms
